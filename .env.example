# =============================================================================
# HireFlow — environment configuration
# Copy to .env and fill in what you need. Everything except the security keys is
# optional: without an LLM key the agent runs on its built-in heuristics.
# =============================================================================

# ---- Deployment -------------------------------------------------------------
ENVIRONMENT=development                 # development | production
# Production (docker-compose.prod.yml) only:
DOMAIN=hireflow.example.com
POSTGRES_PASSWORD=change-me

# Public URLs (the dashboard proxies /api/* to the backend)
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
ALLOW_REGISTRATION=true                 # set false after creating your account

# ---- Security (REQUIRED in production) ---------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
# python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
COOKIE_SECURE=false                     # true when served over HTTPS

# ---- Database / queue (docker-compose sets these for you) --------------------
DATABASE_URL=postgresql+psycopg://hireflow:hireflow@localhost:5432/hireflow
REDIS_URL=redis://localhost:6379/0
# Run background jobs in-process instead of a Celery worker (no Redis needed):
CELERY_TASK_ALWAYS_EAGER=false

# ---- AI provider -----------------------------------------------------------------
# Which model writes, scores and answers. Without any of them the agent runs on built-in heuristics.
# Empty = auto: Claude (ANTHROPIC_API_KEY) first, then OpenAI, then Ollama, whichever is set up.
# anthropic | openai | ollama put that one first; the others stay as fallbacks.
LLM_PROVIDER=
# Claude is the best model here (structured JSON outputs + refusal fallback).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium                 # low | medium | high | xhigh | max
ANTHROPIC_REFUSAL_FALLBACK=true
# Optional secondary provider + embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMBEDDING_PROVIDER=local                # local (no key needed) | openai | ollama (then run: python scripts/migrate.py --reembed)
MAX_LLM_EVALUATIONS_PER_SCAN=40
LLM_CALLS_PER_USER_PER_DAY=400          # each user's daily AI budget (0 = no limit); past it, rule-based versions until tomorrow
DEMO_LLM_CALLS_PER_USER_PER_DAY=40      # the same, in the public demo (DEMO_MODE=true)
DEMO_ANTHROPIC_MODEL=                   # the demo uses these cheaper models when set (your provider's smallest model)
DEMO_OPENAI_MODEL=

# ---- Free AI with Ollama (step by step: docs/OLLAMA.md) ---------------------------
# Ollama runs open models on your own computer or server for free. Set OLLAMA_MODEL to turn it on.
#   Mac:          install the Ollama app (https://ollama.com/download), then ./start.sh --ollama
#   Your server:  re-run scripts/server-setup.sh with WITH_OLLAMA=1 (Ollama in Docker, never exposed)
#   Ollama Cloud: OLLAMA_BASE_URL=https://ollama.com + OLLAMA_API_KEY below
OLLAMA_MODEL=                           # e.g. qwen3.5:4b (default pick, ~3.4 GB) | qwen3.5:9b | llama3.2:3b
# Empty = http://localhost:11434 (inside Docker that means the computer running Docker).
# Ollama in this stack's Docker profile: http://ollama:11434 and COMPOSE_PROFILES=ollama
OLLAMA_BASE_URL=
# COMPOSE_PROFILES=ollama               # start the ollama container with docker compose
# ONLY for Ollama Cloud (https://ollama.com/settings/keys). A local Ollama needs no key.
# Paste it here in this file, never on the command line or in the dashboard.
OLLAMA_API_KEY=
# Tuning (optional; these are the defaults, sized for a CPU-only server)
# OLLAMA_NUM_CTX=8192                   # context window in tokens (Ollama's own default is only 4096)
# OLLAMA_KEEP_ALIVE=30m                 # keep the model loaded between calls
# OLLAMA_TIMEOUT_SECONDS=600            # one answer can take minutes without a GPU
# OLLAMA_CONCURRENCY=1                  # Ollama calls at once (1-2 on a CPU)
# OLLAMA_MAX_EVALUATIONS_PER_SCAN=15    # jobs scored by the model per scan (the rest: instant heuristic)
# OLLAMA_THINK=false                    # true = thinking models reason first: a bit better, much slower
# OLLAMA_EMBED_MODEL=nomic-embed-text   # with EMBEDDING_PROVIDER=ollama (ollama pull nomic-embed-text)
# Scan speed (optional; these are the defaults)
# SCAN_SOURCE_CONCURRENCY=8             # job sources searched at the same time
# SCRAPER_BOARD_CONCURRENCY=6           # company boards / pages fetched at once within a source
# SCAN_LLM_CONCURRENCY=6                # jobs scored by the LLM at the same time
# SCAN_SOURCE_TIMEOUT_SECONDS=240       # sources wrap up at 80% of this; slower ones are left out

# ---- Google (Gmail + Calendar + "Sign in with Google") -----------------------
# Create an OAuth client (type "Web application") at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {FRONTEND_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# Optional real-time Gmail push (otherwise the inbox is polled every EMAIL_POLL_MINUTES)
# projects/<project>/topics/<topic>
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_VERIFICATION_TOKEN=
EMAIL_POLL_MINUTES=5

# ---- Browser automation ---------------------------------------------------------
BROWSER_HEADLESS=true
HUMAN_EMULATION=true                    # human-like typing, mouse paths and dwell times
# comma-separated http://user:pass@host:port (BrightData, Oxylabs…)
PROXY_URLS=
CAPTCHA_PROVIDER=2captcha               # 2captcha | anticaptcha
CAPTCHA_API_KEY=
AUTO_STAGE_APPLICATIONS=true            # fill forms automatically (always pauses for approval)
SUBMISSION_DRY_RUN=false                # true = never click the final Submit button, for everyone (each user can also turn on Dry run)
MAX_APPLICATIONS_PER_DAY_CEILING=25     # hard daily ceiling; users pick 1..this (new users start at 10)
MAX_APPLICATIONS_PER_COMPANY_PER_WEEK=3 # at most this many applications to one company in 7 days
DEMO_MODE=false                         # public demo: nothing is really sent (see docs/HIREFLOW_PLAN.md §5.5)
DEMO_ACCOUNT_EMAIL=demo@hireflow.app    # the demo's shared account for the e2e tests (re-created nightly)
DEMO_SITE_URL=                          # where the worker's browser reaches the bundled demo careers site
                                        # (default {PUBLIC_API_URL}/api/v1/demo-careers; in Docker: http://api:8000/api/v1/demo-careers)

# ---- Storage (resume PDFs, screenshots) --------------------------------------
STORAGE_BACKEND=local                   # local | s3 (AWS S3 / Cloudflare R2 / MinIO)
S3_BUCKET=
# e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Notifications ---------------------------------------------------------------
# Without SMTP, e-mail notifications are sent to yourself via your connected Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HireFlow <no-reply@example.com>
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ---- Monitoring --------------------------------------------------------------------
SENTRY_DSN=                             # API + worker errors (optional); no personal data is sent
SENTRY_TRACES_SAMPLE_RATE=0.1           # share of requests traced for performance
SENTRY_RELEASE=                         # defaults to the deployed commit on Render
LOG_LEVEL=INFO
DATA_RETENTION_DAYS=730
