# URL of the FastAPI backend (server-side, used by the /api proxy)
BACKEND_URL=http://localhost:8000
# Browser-reachable WebSocket endpoint for real-time updates (optional; falls back to polling)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# ---- Public site (the landing page, SEO and links) --------------------------------
# Read at build time: rebuild after changing them.
NEXT_PUBLIC_SITE_URL=http://localhost:3000            # canonical URL for links, the sitemap and social previews
NEXT_PUBLIC_GITHUB_URL=https://github.com/saksham-eng560/HireFlow
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_AUTHOR_URL=
NEXT_PUBLIC_DEMO_VIDEO_URL=                           # a YouTube or Loom link, or an .mp4 / .webm file
